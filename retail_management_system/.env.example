# Copy this file to .env (same folder as manage.py) and fill in the values.
# .env holds secrets and is ignored by git; this example file is safe to commit.

# ── Telegram group notifications for FE orders ──
# The bot token from @BotFather, e.g. 7123456789:AAH...
TELEGRAM_BOT_TOKEN=
# The orders group's chat ID. Find it with:  python manage.py telegram chats
# Groups have negative IDs, e.g. -1001234567890 (include the minus sign)
TELEGRAM_ORDERS_CHAT_ID=

# ── WhatsApp group notifications for FE orders (WAHA) ──
# WAHA's address as seen from the web container (both run in docker-compose; use http://localhost:3000 outside Docker)
WAHA_URL=http://waha:3000
# WAHA is started with these (see the waha service in docker-compose.yml), so they never change on restart.
# Make up long random values, e.g.  python -c "import secrets; print(secrets.token_hex(16))"
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WAHA_SESSION=default
# The orders group's chat ID. Find it with:  python manage.py whatsapp groups
# Groups look like 120363000000000000@g.us
WHATSAPP_ORDERS_CHAT_ID=

# ── Address and security ──
# The address people open the system on. Also used for links in emails (e.g. 'Open Car Allocations').
# Its host is allowed automatically. On Azure App Service leave it out: the app uses its own
# https://<app>.azurewebsites.net address until you add a custom domain (then set SITE_URL there).
# Azure App Service doesn't read this file: put these values under the app's Environment variables (see DEPLOY_AZURE.md).
SITE_URL=http://10.10.8.49:8000
# Required whenever DEBUG is off (always on Azure); the app refuses to start with the default key.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Extra host names to accept besides SITE_URL's, comma-separated (usually not needed)
# ALLOWED_HOSTS=

# ── Microsoft 365 email notifications (Microsoft Graph) ──
# From the Azure app registration: Entra ID → App registrations → your app → Overview
OFFICE365_TENANT_ID=
OFFICE365_CLIENT_ID=
# Certificates & secrets → New client secret → copy the secret's VALUE (not its ID)
OFFICE365_CLIENT_SECRET=
# The mailbox the emails are sent from (a real or shared mailbox in your tenant)
OFFICE365_SENDER=
DEFAULT_FROM_EMAIL=
# Who receives them, comma-separated
OFFICE365_ORDER_EMAILS=
OFFICE365_ISSUE_EMAILS=
# Who is alerted when an order's WhatsApp group message fails (one email per order, not one per retry)
OFFICE365_WHATSAPP_ALERT_EMAILS=
# Car booking emails need no setting: they go from the booker's own mailbox (the email on their account)
# to every user in every group except fe_boys
